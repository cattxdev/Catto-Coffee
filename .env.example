# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_client_id_here

# Optional: Development Guild ID for faster command testing
DEV_GUILD_ID=

# Bot Owners (comma-separated user IDs)
OWNER_IDS=

# Environment
NODE_ENV=development

# Command Settings
PREFIX=!
REGISTER_GLOBALLY=false

# Logging
LOG_LEVEL=info
LOG_TO_FILE=false

# Database (optional)
DATABASE_ENABLED=false
DATABASE_URL=

# Redis Cache (optional)
# Use either REDIS_URL or individual options (REDIS_HOST, REDIS_PORT, etc.)
REDIS_URL=redis://localhost:6379
# Or use individual options:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# API (optional)
API_ENABLED=false
API_PORT=3000
