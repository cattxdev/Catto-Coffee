{
  "name": "catto.djs",
  "version": "1.0.0",
  "description": "A well-structured, enterprise-grade Discord.js v14 bot with TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "clean": "rmdir /s /q dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "discord",
    "bot",
    "typescript",
    "discord.js"
  ],
  "author": "Catto Bot Team",
  "license": "ISC",
  "packageManager": "pnpm@10.11.0",
  "dependencies": {
    "@prisma/client": "6.17.1",
    "@types/signale": "^1.4.7",
    "discord.js": "^14.23.2",
    "dotenv": "^17.2.3",
    "ioredis": "^5.8.1",
    "signale": "^1.4.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.7.2",
    "@types/ws": "^8.18.1",
    "discord-api-types": "^0.38.30",
    "jest": "^30.2.0",
    "prisma": "6.17.1",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "signale": {
    "displayScope": true,
    "displayBadge": true,
    "displayDate": true,
    "displayFilename": false,
    "displayLabel": true,
    "displayTimestamp": true,
    "underlineLabel": true
  }
}
